# Base URL of the Express API (including /api). Copy this file to .env.
# Anything starting with VITE_ is bundled into the public JavaScript: never put secrets here.
VITE_API_URL=http://localhost:5001/api

# Optional. Must match the server's PLATFORM_DOMAIN. Leave empty: publications are then served at /p/<address> only.
VITE_PLATFORM_DOMAIN=
