PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Paste your Atlas "Drivers" connection string, replace <username>/<password>,
# and put the database name "hashnode" after the host (before the "?").
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/hashnode?retryWrites=true&w=majority
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<long-random-string>
JWT_EXPIRES_IN=7d

# Optional. The domain publication subdomains will live under (e.g. devpress.example makes
# <slug>.devpress.example). Leave empty until a real domain with wildcard DNS is configured.
PLATFORM_DOMAIN=

# ---- Email (password reset) ----
# Any SMTP provider. Leave SMTP_HOST empty in development to print reset links in this terminal
# instead (never in production: there, reset requests are refused until email is configured).
#
# Gmail: turn on 2-Step Verification, create an App Password (Google Account > Security >
# App passwords), then:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=<16-character app password, no spaces>
#   MAIL_FROM=DevPress <you@gmail.com>
#
# Other providers (Brevo, Mailgun, Postmark, SES...): use their SMTP host, port 587, SMTP_SECURE=false.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
